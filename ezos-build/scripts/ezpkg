#!/bin/sh
set -euo pipefail

MAIN_REPO="https://raw.githubusercontent.com/mrzgamingv20-cyber/ezos-repo/main"
REPO_FILE="/var/lib/ezpkg/repos.list"
DB="/var/lib/ezpkg/installed.txt"
CACHE="/var/cache/ezpkg"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'

mkdir -p "$(dirname "$DB")" "$CACHE"
[ -f "$REPO_FILE" ] || touch "$REPO_FILE"

banner() { echo -e "${CYAN}━━━ EZPKG ━━━${NC}"; }

get_repo_names() {
    echo "$MAIN_REPO"
    [ -s "$REPO_FILE" ] && cat "$REPO_FILE"
}

repo_desc() {
    url="$1"; pkg="$2"
    index=$(wget -qO- "${url}/packages/index.json" 2>/dev/null || true)
    if [ -n "$index" ]; then
        desc=$(echo "$index" | grep -A1 "\"${pkg}\":" | grep '"' | sed 's/.*: *"//;s/"$//' | head -1)
        [ -n "$desc" ] && echo "$desc" && return 0
    fi
    echo "No description"
}

repo_list_pkgs() {
    url="$1"
    wget -qO- "${url}/packages/" 2>/dev/null | grep -oE 'href="[^"]+\.tar\.gz"' | sed 's/href="//;s/"//;s/.tar.gz//' || true
}

repo_add() {
    url="$1"
    if grep -qxF "$url" "$REPO_FILE" 2>/dev/null; then
        echo -e "${YELLOW}[!]${NC} Repo sudah ada."; exit 0
    fi
    echo "$url" >> "$REPO_FILE"
    echo -e "${GREEN}[✓]${NC} Repo added: $url"
    repo_auto_install "$url"
}

repo_auto_install() {
    url="$1"
    pkgs=$(repo_list_pkgs "$url")
    if [ -z "$pkgs" ]; then
        echo -e "${RED}[✗]${NC} Tidak ada package ditemukan di repo."; exit 1
    fi
    for pkg in $pkgs; do
        desc=$(repo_desc "$url" "$pkg" 2>/dev/null || echo "")
        echo -e "${BLUE}[→]${NC} ${GREEN}$pkg${NC} — $desc"
        echo -ne "${YELLOW}[?]${NC} Install $pkg dari $url? [Y/n]: "
        read -r answer
        case "$answer" in
            n|N) echo -e "${YELLOW}[–]${NC} Skip $pkg"; continue ;;
        esac
        install_from_repo "$pkg" "$url"
    done
}

install_from_repo() {
    pkg="$1"; url="$2"
    file="$CACHE/${pkg}.tar.gz"
    dl_url="${url}/packages/${pkg}.tar.gz"
    echo -e "${BLUE}[*]${NC} Downloading $pkg..."
    wget -q "$dl_url" -O "$file" || { echo -e "${RED}[✗]${NC} Download gagal"; return 1; }
    tar -tzf "$file" >/dev/null 2>&1 || { echo -e "${RED}[✗]${NC} Invalid package"; rm -f "$file"; return 1; }
    echo -e "${BLUE}[↗]${NC} Installing $pkg..."
    tar -xzf "$file" -C / || { echo -e "${RED}[✗]${NC} Extraction gagal"; return 1; }
    grep -qxF "$pkg" "$DB" 2>/dev/null || echo "$pkg" >> "$DB"
    echo -e "${GREEN}[✓]${NC} $pkg terpasang!"
}

repo_remove() {
    url="$1"
    if ! grep -qxF "$url" "$REPO_FILE" 2>/dev/null; then
        echo -e "${YELLOW}[!]${NC} Repo tidak ditemukan."; exit 0
    fi
    grep -vxF "$url" "$REPO_FILE" > "$REPO_FILE.tmp" && mv "$REPO_FILE.tmp" "$REPO_FILE"
    echo -e "${GREEN}[✓]${NC} Repo dihapus: $url"
}

repo_list() {
    echo -e "${CYAN}── Repo yang aktif ──${NC}"
    echo -e "  ${BLUE}[main]${NC} $MAIN_REPO ($(repo_list_pkgs "$MAIN_REPO" | wc -w) packages)"
    if [ -s "$REPO_FILE" ]; then
        i=1; while IFS= read -r url; do
            count=$(repo_list_pkgs "$url" | wc -w)
            echo -e "  ${BLUE}[extra-$i]${NC} $url ($count packages)"
            i=$((i+1))
        done < "$REPO_FILE"
    else
        echo -e "  ${YELLOW}(tidak ada extra repo)${NC}"
    fi
}

repo_count() {
    total=0
    for repo in $(get_repo_names); do
        count=$(repo_list_pkgs "$repo" 2>/dev/null | wc -w)
        total=$((total + count))
        echo -e "  ${BLUE}$repo${NC} — $count packages"
    done
    echo -e "${GREEN}[✓]${NC} Total: $total packages across all repos"
}

list_remote() {
    echo -e "${CYAN}── Available packages ──${NC}"
    for repo in $(get_repo_names); do
        echo -e "${BLUE}$repo${NC}:"
        pkgs=$(repo_list_pkgs "$repo" 2>/dev/null)
        if [ -z "$pkgs" ]; then echo -e "  ${YELLOW}(empty)${NC}"; continue; fi
        for pkg in $pkgs; do
            desc=$(repo_desc "$repo" "$pkg" 2>/dev/null || echo "")
            installed=""; grep -qxF "$pkg" "$DB" 2>/dev/null && installed="${GREEN}✓${NC}"
            echo -e "  ${GREEN}$pkg${NC} — $desc $installed"
        done
    done
}

installed_list() {
    echo -e "${CYAN}── Installed packages ──${NC}"
    if [ ! -f "$DB" ] || [ ! -s "$DB" ]; then
        echo -e "  ${YELLOW}(none installed)${NC}"; return
    fi
    count=0
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        echo -e "  ${GREEN}✓${NC} $pkg"; count=$((count+1))
    done < "$DB"
    echo -e "${GREEN}[✓]${NC} $count package(s) installed"
}

search_pkg() {
    query="$1"
    echo -e "${CYAN}── Search: $query ──${NC}"
    found=0
    for repo in $(get_repo_names); do
        pkgs=$(repo_list_pkgs "$repo" 2>/dev/null)
        for pkg in $pkgs; do
            case "$pkg" in
                *"$query"*)
                    desc=$(repo_desc "$repo" "$pkg" 2>/dev/null || echo "")
                    echo -e "  ${GREEN}$pkg${NC} — $desc"
                    echo -e "    ${BLUE}from${NC} $repo"
                    found=1
                    ;;
            esac
        done
    done
    [ "$found" -eq 0 ] && echo -e "  ${RED}[✗]${NC} Tidak ada hasil untuk '$query'"
}

info_pkg() {
    pkg="$1"; found=0
    for repo in $(get_repo_names); do
        dl_url="${repo}/packages/${pkg}.tar.gz"
        if wget -q --spider "$dl_url" 2>/dev/null; then
            desc=$(repo_desc "$repo" "$pkg" 2>/dev/null || echo "N/A")
            echo -e "${CYAN}── Info: $pkg ──${NC}"
            echo -e "  ${BLUE}Package:${NC} $pkg"
            echo -e "  ${BLUE}Description:${NC} $desc"
            echo -e "  ${BLUE}Repo:${NC} $repo"
            echo -e "  ${BLUE}URL:${NC} $dl_url"
            if grep -qxF "$pkg" "$DB" 2>/dev/null; then
                echo -e "  ${GREEN}Status:${NC} ${GREEN}Installed${NC}"
            else
                echo -e "  ${RED}Status:${NC} ${RED}Not installed${NC}"
            fi
            found=1; break
        fi
    done
    [ "$found" -eq 0 ] && echo -e "${RED}[✗]${NC} Package $pkg tidak ditemukan."
}

install_pkg() {
    pkg="$1"; found=0
    for repo in $(get_repo_names); do
        dl_url="${repo}/packages/${pkg}.tar.gz"
        if wget -q --spider "$dl_url" 2>/dev/null; then
            desc=$(repo_desc "$repo" "$pkg" 2>/dev/null || echo "")
            echo -e "${BLUE}[→]${NC} $pkg ditemukan di $repo"
            echo -e "  ${CYAN}$desc${NC}"
            echo -ne "${YELLOW}[?]${NC} Install $pkg dari $repo? [Y/n]: "
            read -r answer
            case "$answer" in
                n|N) echo -e "${YELLOW}[–]${NC} Skip"; found=1; break ;;
            esac
            install_from_repo "$pkg" "$repo"; found=1; break
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo -e "${RED}[✗]${NC} Package $pkg tidak ditemukan di repo manapun."
        echo -e "  ${BLUE}Try:${NC} ezpkg search $pkg"
    fi
}

install_yes_pkg() {
    pkg="$1"
    for repo in $(get_repo_names); do
        dl_url="${repo}/packages/${pkg}.tar.gz"
        if wget -q --spider "$dl_url" 2>/dev/null; then
            echo -e "${BLUE}[→]${NC} $pkg ditemukan di $repo"
            install_from_repo "$pkg" "$repo"; return 0
        fi
    done
    echo -e "${RED}[✗]${NC} Package $pkg tidak ditemukan."
    return 1
}

remove_pkg() {
    pkg="$1"
    if ! grep -qxF "$pkg" "$DB" 2>/dev/null; then
        echo -e "${YELLOW}[!]${NC} $pkg tidak terinstall via ezpkg."
        echo -e "  ${BLUE}Try:${NC} apt remove $pkg"; return 1
    fi
    echo -e "${BLUE}[*]${NC} Removing $pkg..."
    for repo in $(get_repo_names); do
        dl_url="${repo}/packages/${pkg}.tar.gz"
        if wget -q --spider "$dl_url" 2>/dev/null; then
            echo -e "${BLUE}[↗]${NC} Extracting removal script..."
            tmpdir=$(mktemp -d)
            file="$CACHE/${pkg}.tar.gz"
            wget -q "$dl_url" -O "$file" 2>/dev/null
            tar -xzf "$file" -C "$tmpdir" ./DEBIAN/prerm 2>/dev/null || true
            if [ -f "$tmpdir/./DEBIAN/prerm" ]; then
                sh "$tmpdir/./DEBIAN/prerm" 2>/dev/null || true
            fi
            rm -rf "$tmpdir"
            break
        fi
    done
    grep -vxF "$pkg" "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
    echo -e "${GREEN}[✓]${NC} $pkg dihapus."
}

upgrade_pkg() {
    echo -e "${CYAN}── Upgrading packages ──${NC}"
    count=0
    for repo in $(get_repo_names); do
        pkgs=$(repo_list_pkgs "$repo" 2>/dev/null)
        for pkg in $pkgs; do
            dl_url="${repo}/packages/${pkg}.tar.gz"
            if wget -q --spider "$dl_url" 2>/dev/null; then
                echo -e "  ${BLUE}[↻]${NC} $pkg..."
                install_from_repo "$pkg" "$repo" >/dev/null 2>&1 && count=$((count+1))
            fi
        done
    done
    echo -e "${GREEN}[✓]${NC} $count package(s) upgraded."
}

clean_cache() {
    echo -e "${CYAN}── Cleaning cache ──${NC}"
    count=$(ls "$CACHE"/*.tar.gz 2>/dev/null | wc -l)
    rm -f "$CACHE"/*.tar.gz
    echo -e "${GREEN}[✓]${NC} Removed $count cached package(s)."
}

version_ezos() {
    echo -e "${CYAN}── EZOS Version ──${NC}"
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo -e "  ${BLUE}NAME:${NC} $NAME"
        echo -e "  ${BLUE}ID:${NC} $ID"
        echo -e "  ${BLUE}VERSION:${NC} $VERSION_ID"
        echo -e "  ${BLUE}PRETTY_NAME:${NC} $PRETTY_NAME"
    else
        echo -e "  ${YELLOW}Version info not found${NC}"
    fi
}

do_list() {
    echo -e "${CYAN}── Installed EZOS packages ──${NC}"
    if [ -f "$DB" ]; then cat "$DB"; else echo "(none)"; fi
}

repo_update() {
    echo -e "${CYAN}── Updating repo info ──${NC}"
    for repo in $(get_repo_names); do
        count=$(repo_list_pkgs "$repo" 2>/dev/null | wc -w)
        echo -e "  ${BLUE}$repo${NC} — $count packages available"
    done
    echo -e "${GREEN}[✓]${NC} Repo info updated."
}

case "${1:-}" in
    repo)
        case "${2:-}" in
            add) [ -z "${3:-}" ] && { echo "Usage: ezpkg repo add <url>"; exit 1; }; repo_add "$3" ;;
            remove) [ -z "${3:-}" ] && { echo "Usage: ezpkg repo remove <url>"; exit 1; }; repo_remove "$3" ;;
            list) repo_list ;;
            update) repo_update ;;
            count) repo_count ;;
            *) echo "Usage: ezpkg repo add|remove|list|update|count <url>"; exit 1 ;;
        esac
        ;;
    install) [ -z "${2:-}" ] && { echo "Usage: ezpkg install <package>"; exit 1; }; banner; install_pkg "$2" ;;
    install-yes) [ -z "${2:-}" ] && { echo "Usage: ezpkg install-yes <package>"; exit 1; }; banner; install_yes_pkg "$2" ;;
    remove) [ -z "${2:-}" ] && { echo "Usage: ezpkg remove <package>"; exit 1; }; banner; remove_pkg "$2" ;;
    upgrade) banner; upgrade_pkg ;;
    clean) banner; clean_cache ;;
    version) version_ezos ;;
    list-remote) banner; list_remote ;;
    installed) banner; installed_list ;;
    search) [ -z "${2:-}" ] && { echo "Usage: ezpkg search <query>"; exit 1; }; banner; search_pkg "$2" ;;
    info) [ -z "${2:-}" ] && { echo "Usage: ezpkg info <package>"; exit 1; }; banner; info_pkg "$2" ;;
    list) banner; do_list ;;
    *) echo "EZPKG - EZOS Package Manager"; echo; echo "Usage:"; echo "  ezpkg install <pkg>"; echo "  ezpkg install-yes <pkg>"; echo "  ezpkg remove <pkg>"; echo "  ezpkg upgrade"; echo "  ezpkg clean"; echo "  ezpkg version"; echo "  ezpkg search <query>"; echo "  ezpkg info <pkg>"; echo "  ezpkg list-remote"; echo "  ezpkg installed"; echo "  ezpkg repo add <url>"; echo "  ezpkg repo remove <url>"; echo "  ezpkg repo list"; echo "  ezpkg repo update"; echo "  ezpkg repo count"; echo "  ezpkg list" ;;
esac
