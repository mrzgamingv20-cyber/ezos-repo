#!/bin/sh
set -euo pipefail

MAIN_REPO="https://raw.githubusercontent.com/mrzgamingv20-cyber/ezos-repo/main"
REPO_FILE="/var/lib/ezpkg/repos.list"
DB="/var/lib/ezpkg/installed.txt"
CACHE="/var/cache/ezpkg"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'

mkdir -p "$(dirname "$DB")" "$CACHE"
[ -f "$REPO_FILE" ] || touch "$REPO_FILE"

banner() { echo -e "${CYAN}━━━ EZPKG ━━━${NC}"; }

repo_add() {
    url="$1"
    if grep -qxF "$url" "$REPO_FILE" 2>/dev/null; then
        echo -e "${YELLOW}[!]${NC} Repo sudah ada."; exit 0
    fi
    echo "$url" >> "$REPO_FILE"
    echo -e "${GREEN}[✓]${NC} Repo added: $url"
    repo_auto_install "$url"
}

repo_auto_install() {
    url="$1"
    pkg_dir="${url}/packages"
    pkgs=$(wget -qO- "${pkg_dir}" 2>/dev/null | grep -oP 'href="[^"]+\.tar\.gz"' | sed 's/href="//;s/"//;s/.tar.gz//' || true)
    if [ -z "$pkgs" ]; then
        index=$(wget -qO- "${url}/packages/index.json" 2>/dev/null || true)
        if [ -n "$index" ]; then
            pkgs=$(echo "$index" | grep -oP '"\K[^"]+(?=":)')
        fi
    fi
    if [ -z "$pkgs" ]; then
        echo -e "${RED}[✗]${NC} Tidak ada package ditemukan di repo."
        exit 1
    fi
    for pkg in $pkgs; do
        echo -e "${BLUE}[→]${NC} Ditemukan package: ${GREEN}$pkg${NC}"
        echo -ne "${YELLOW}[?]${NC} Install $pkg dari $url? [Y/n]: "
        read -r answer
        case "$answer" in
            n|N) echo -e "${YELLOW}[–]${NC} Skip $pkg"; continue ;;
        esac
        install_from_repo "$pkg" "$url"
    done
}

install_from_repo() {
    pkg="$1"
    url="$2"
    file="$CACHE/${pkg}.tar.gz"
    dl_url="${url}/packages/${pkg}.tar.gz"
    echo -e "${BLUE}[*]${NC} Downloading $pkg..."
    wget -q "$dl_url" -O "$file" || { echo -e "${RED}[✗]${NC} Download gagal"; return 1; }
    tar -tzf "$file" >/dev/null 2>&1 || { echo -e "${RED}[✗]${NC} Invalid package"; rm -f "$file"; return 1; }
    echo -e "${BLUE}[↗]${NC} Installing $pkg..."
    tar -xzf "$file" -C / || { echo -e "${RED}[✗]${NC} Extraction gagal"; return 1; }
    grep -qxF "$pkg" "$DB" 2>/dev/null || echo "$pkg" >> "$DB"
    echo -e "${GREEN}[✓]${NC} $pkg terpasang!"
}

repo_remove() {
    url="$1"
    if ! grep -qxF "$url" "$REPO_FILE" 2>/dev/null; then
        echo -e "${YELLOW}[!]${NC} Repo tidak ditemukan."; exit 0
    fi
    grep -vxF "$url" "$REPO_FILE" > "$REPO_FILE.tmp" && mv "$REPO_FILE.tmp" "$REPO_FILE"
    echo -e "${GREEN}[✓]${NC} Repo dihapus: $url"
}

repo_list() {
    echo -e "${CYAN}── Repo yang aktif ──${NC}"
    echo -e "  ${BLUE}[main]${NC} $MAIN_REPO"
    if [ -s "$REPO_FILE" ]; then
        i=1; while IFS= read -r url; do
            echo -e "  ${BLUE}[extra-$i]${NC} $url"; i=$((i+1))
        done < "$REPO_FILE"
    else
        echo -e "  ${YELLOW}(tidak ada extra repo)${NC}"
    fi
}

install_pkg() {
    pkg="$1"
    found=0
    for repo in "$MAIN_REPO" $(cat "$REPO_FILE" 2>/dev/null); do
        dl_url="${repo}/packages/${pkg}.tar.gz"
        if wget -q --spider "$dl_url" 2>/dev/null; then
            echo -e "${BLUE}[→]${NC} $pkg ditemukan di $repo"
            echo -ne "${YELLOW}[?]${NC} Install $pkg dari $repo? [Y/n]: "
            read -r answer
            case "$answer" in
                n|N) echo -e "${YELLOW}[–]${NC} Skip"; found=1; break ;;
            esac
            install_from_repo "$pkg" "$repo"
            found=1
            break
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo -e "${RED}[✗]${NC} Package $pkg tidak ditemukan di repo manapun."
    fi
}

do_list() {
    echo -e "${CYAN}── Installed EZOS packages ──${NC}"
    if [ -f "$DB" ]; then cat "$DB"; else echo "(none)"; fi
}

case "${1:-}" in
    repo)
        case "${2:-}" in
            add) [ -z "${3:-}" ] && { echo "Usage: ezpkg repo add <url>"; exit 1; }; repo_add "$3" ;;
            remove) [ -z "${3:-}" ] && { echo "Usage: ezpkg repo remove <url>"; exit 1; }; repo_remove "$3" ;;
            list) repo_list ;;
            *) echo "Usage: ezpkg repo add|remove|list <url>"; exit 1 ;;
        esac
        ;;
    install) [ -z "${2:-}" ] && { echo "Usage: ezpkg install <package>"; exit 1; }; banner; install_pkg "$2" ;;
    list) banner; do_list ;;
    *) echo "EZPKG - EZOS Package Manager"; echo; echo "Usage:"; echo "  ezpkg install <pkg>"; echo "  ezpkg repo add <url>"; echo "  ezpkg repo remove <url>"; echo "  ezpkg repo list"; echo "  ezpkg list" ;;
esac
