    "history": [
      {
        "comment": "debuerreotype 0.17",
        "created": "2026-07-13T00:00:00Z",
        "created_by": "# debian.sh --arch 'arm64' out/ 'bookworm' '@1783900800'"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "COPY motd.txt /etc/motd"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "RUN echo 'NAME=\"EZOS\"' > /etc/os-release && echo 'ID=ezos' >> /etc/os-release && echo 'VERSION_ID=\"3.0\"' >> /etc/os-release && echo 'PRETTY_NAME=\"EZOS 3.0 (Debian-based)\"' >> /etc/os-release && echo 'cat /etc/motd' >> /etc/profile && apt update && apt install -y wget curl nano"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "RUN mkdir -p /usr/local/bin && printf '#!/bin/sh\\nREPO=\"https://raw.githubusercontent.com/mrzgamingv20-cyber/ezos-repo/main\"\\nDB=\"/var/lib/ezpkg/installed.txt\"\\nmkdir -p /var/lib/ezpkg\\ncase \"$1\" in\\n  install)\\n    pkg=\"$2\"\\n    if wget -q --spider \"$REPO/packages/$pkg.tar.gz\"; then\\n      wget -q \"$REPO/packages/$pkg.tar.gz\" -O \"/tmp/$pkg.tar.gz\"\\n      tar -xzf \"/tmp/$pkg.tar.gz\" -C /\\n      echo \"$pkg\" >> \"$DB\"\\n      echo \"$pkg installed (from EZOS repo).\"\\n    else\\n      apt install -y \"$pkg\" && echo \"$pkg installed (from Debian repo).\"\\n    fi\\n    ;;\\n  remove)\\n    apt remove -y \"$2\" 2>/dev/null\\n    sed -i \"/^$2$/d\" \"$DB\" 2>/dev/null\\n    echo \"$2 removed.\"\\n    ;;\\n  search)\\n    apt-cache search \"$2\"\\n    ;;\\n  update)\\n    apt update\\n    ;;\\n  upgrade)\\n    apt upgrade -y\\n    ;;\\n  list)\\n    echo \"--- EZOS repo packages ---\"\\n    cat \"$DB\" 2>/dev/null || echo \"(none)\"\\n    ;;\\n  *)\\n    echo \"Usage: ezpkg [install|remove|search|update|upgrade|list] <package>\"\\n    ;;\\nesac\\n' > /usr/local/bin/ezpkg && chmod +x /usr/local/bin/ezpkg"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "RUN echo \"alias fastfetch='fastfetch --logo /etc/motd --logo-type file'\" >> /root/.bashrc"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "RUN mkdir -p /root/.config/fastfetch"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "COPY fastfetch-config/config.jsonc /root/.config/fastfetch/config.jsonc"
      },
      {
        "created": "1970-01-01T00:00:00Z",
        "created_by": "RUN echo \"alias fastfetch='fastfetch -c /root/.config/fastfetch/config.jsonc'\" >> /root/.bashrc"
      }
    ],
